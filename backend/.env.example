# Copy this file to ".env" and fill in your own values.

# PostgreSQL connection string.
# Neon (free): https://neon.tech -> your project -> "Connection string"
# Example: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Local Postgres example: postgresql://postgres:postgres@localhost:5432/calap_alert
DATABASE_URL=

# Any long random text. Used to sign login tokens. Change it before going live.
JWT_SECRET=change-this-to-a-long-random-string

# Port the API runs on
PORT=4000

# Optional: comma-separated list of allowed web origins (leave empty to allow all during development)
CORS_ORIGIN=
